# Copy this file to ".env" and fill it in. NEVER commit or share the real .env.
# (Do not paste these values into chats, screenshots or videos.)

# Configure one Angel One SmartAPI account here, or add it in Settings -> Angel One account.
# Environment variables take precedence over the encrypted account saved by the terminal.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Optional TOTP setup key. Leave blank to enter the current 6-digit code at connect time.
ANGEL_TOTP_SECRET=

# Password for the terminal's own login screen (8+ characters)
DASHBOARD_PASSWORD=

# Second lock for real-money mode. Must be exactly "yes" for mode: live to start.
ALLOW_LIVE=no

# Optional: Telegram alerts (see README, "Telegram alerts"). Both are needed.
# TELEGRAM_BOT_TOKEN comes from @BotFather; TELEGRAM_CHAT_ID from tools/telegram_chat_id.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated public IPv4 egress addresses registered in Angel One SmartAPI.
# Configure the registered primary and optional secondary IPv4 addresses.
ANGEL_STATIC_IP=
# Optional: route SmartAPI REST calls and outbound-IP checks through a static egress proxy.
# HTTPS_PROXY=
# HTTP_PROXY=
